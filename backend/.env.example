APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5433/web-my-porto?sslmode=disable

# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=change_me
JWT_EXPIRES_IN=24h

SUPABASE_STORAGE_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=ap-southeast-1
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=web-my-porto
SUPABASE_STORAGE_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public/web-my-porto

FRONTEND_ORIGIN=http://localhost:3000
