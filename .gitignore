# Env
.env
backend/.env
frontend/.env

# Allow example files
!.env.example
!backend/.env.example
!frontend/.env.example

# Go
backend/bin/
backend/tmp/
backend/*.exe
backend/*.test
backend/coverage.out

# Node / Nuxt
frontend/node_modules/
frontend/.nuxt/
frontend/.output/
frontend/dist/
frontend/.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS / Editor
.DS_Store
.vscode/
.idea/

# Docker
docker-compose.override.yml

# Database dump
*.sql
*.dump
*.backup

# Cookies / sensitive temp files
cookies.txt
**/cookies.txt
